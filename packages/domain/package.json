{
  "name": "@staydesk/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure domain rules: dates, stays, availability, booking lifecycle, permissions. No I/O.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
