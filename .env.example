# ───────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY. Copy to .env (git-ignored) and adjust if you like.
# Every value here is a throwaway placeholder for a database on 127.0.0.1.
# Production secrets live in the server's encrypted env files, never in git.
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# Docker Compose (infra/docker-compose.yml) — used only when the database is first created
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
SD_OWNER_PASSWORD=owner_dev_only
SD_APP_PASSWORD=app_dev_only
SD_WORKER_PASSWORD=worker_dev_only
SD_PLATFORM_PASSWORD=platform_dev_only
SD_READONLY_PASSWORD=readonly_dev_only

# Prisma CLI (migrations) connects as the schema owner
MIGRATE_DATABASE_URL=postgresql://sd_owner:owner_dev_only@localhost:5432/staydesk

# Runtime connections — one role per responsibility
DATABASE_URL=postgresql://sd_app:app_dev_only@localhost:5432/staydesk
WORKER_DATABASE_URL=postgresql://sd_worker:worker_dev_only@localhost:5432/staydesk
PLATFORM_DATABASE_URL=postgresql://sd_platform:platform_dev_only@localhost:5432/staydesk

REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025

API_PORT=4000
WEB_PORT=3000
# Where the web app's server side reaches the API in development
API_INTERNAL_URL=http://localhost:4000

# API security (dev placeholders — generate real values per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
PASSWORD_PEPPER=dev-only-password-pepper-change-me-0123456789
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktY2hhbmdlLW1lLTAwMDA=
# Plain-HTTP localhost only; production keeps the default (true → __Host- cookies)
COOKIE_SECURE=false
# Trust X-Forwarded-* from the local Next.js dev server / Caddy
TRUST_PROXY=loopback

# Public origin of each portal (used in email links)
HOTEL_ORIGIN=http://app.localhost:3000
AGENT_ORIGIN=http://agent.localhost:3000
ADMIN_ORIGIN=http://admin.localhost:3000
MAIL_FROM=StayDesk <no-reply@staydesk.local>
