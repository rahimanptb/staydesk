{
  "name": "@staydesk/api",
  "version": "0.0.0",
  "private": true,
  "description": "StayDesk HTTP API (NestJS on Fastify).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "bootstrap:super-admin": "node --env-file-if-exists=../../.env dist/cli/bootstrap-super-admin.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@staydesk/config": "workspace:*",
    "@staydesk/contracts": "workspace:*",
    "@staydesk/db": "workspace:*",
    "@staydesk/domain": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.14",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
